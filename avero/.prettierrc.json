{
    "plugins": ["prettier-plugin-sql"],
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "always",
    "overrides": [
        {
            "files": "*.sql",
            "options": {
                "parser": "sql",
                "language": "postgresql",
                "keywordCase": "upper",
                "tabWidth": 4
            }
        }
    ]
}
